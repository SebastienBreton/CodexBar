#!/usr/bin/python3
"""CodexBar AppIndicator for GNOME / Ubuntu (and other AppIndicator desktops).

Displays CodexBar usage in the desktop top bar using Ayatana AppIndicator.
Usage data comes from the native `codexbar` CLI (the same Linux CLI shipped by
upstream via Homebrew, the AUR, or the release tarballs); this indicator is a
thin front-end over `codexbar usage --format json`.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Any

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3, GLib, Gtk

SCRIPT_DIR = Path(__file__).resolve().parent
def _resolve_config_path() -> Path:
    # New installs use ~/.config/codexbar/config.json; older installs still
    # keep ~/.codexbar/config.json. Prefer the new path, fall back to legacy.
    new_path = Path.home() / ".config" / "codexbar" / "config.json"
    legacy_path = Path.home() / ".codexbar" / "config.json"
    if new_path.exists():
        return new_path
    return legacy_path


CONFIG_PATH = _resolve_config_path()
ICON_NAME = "codexbar-icon"
REFRESH_INTERVAL_SEC = int(os.environ.get("CODEXBAR_REFRESH_INTERVAL_SEC", "120"))
FETCH_TIMEOUT_SEC = int(os.environ.get("CODEXBAR_FETCH_TIMEOUT_SEC", "120"))

