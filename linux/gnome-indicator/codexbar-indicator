    "codex": "cli",
    "claude": "oauth",
    "copilot": "api",
    "gemini": "api",
    "kiro": "cli",
    "kilo": "auto",
    "openrouter": "api",
    "synthetic": "api",
    "warp": "api",
    "zai": "api",
}

DEFAULT_PROVIDERS = ["codex", "claude"]

PROVIDER_LABELS = {
    "codex": "Ox",
    "claude": "Cl",
    "copilot": "Gh",
    "gemini": "Ge",
    "kiro": "Ki",
    "kilo": "Kl",
    "openrouter": "Or",
    "synthetic": "Sy",
    "warp": "Wp",
    "zai": "Za",
}

PROVIDER_NAMES = {
    "codex": "Codex",
    "claude": "Claude",
    "copilot": "Copilot",
    "gemini": "Gemini",
    "kiro": "Kiro",
    "kilo": "Kilo",
    "openrouter": "OpenRouter",
    "synthetic": "Synthetic",
    "warp": "Warp",
    "zai": "z.ai",
}

WINDOW_TITLES = {
    "primary": "Session",
    "secondary": "Weekly",
    "tertiary": "Monthly",
}

